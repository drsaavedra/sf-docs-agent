{
  "name": "sf-docs-agent",
  "version": "0.1.10",
  "type": "module",
  "description": "Salesforce documentation agent for Claude Code: a subagent that answers from the official Salesforce docs (developer, architect, Help, admin, SLDS) with verbatim, grep-checked quotes and their URLs. No API key, no MCP server.",
  "devDependencies": {
    "playwright-core": "1.64.1"
  },
  "bin": {
    "sf-docs-agent": "bin/install.mjs"
  },
  "files": [
    "bin",
    "agents",
    "fetch-docs.mjs",
    "guard.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drsaavedra/sf-docs-agent.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude-code",
    "subagent",
    "salesforce",
    "documentation",
    "llms.txt",
    "playwright",
    "salesforce-documentation",
    "ai-agent",
    "apex",
    "lwc"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec 'test/*.test.mjs'"
  }
}
